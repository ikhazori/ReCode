# === Unity: carpetas generadas ===
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/

# === Unity: assets autogenerados por herramientas ===
/[Aa]ssets/Plugins/Editor/JetBrains*
/[Aa]ssets/[Ss]treamingAssets/aa.meta
/[Aa]ssets/[Ss]treamingAssets/aa/*

# === Solución y proyectos C# (Unity los regenera) ===
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
.vs/

# === Crash / debug ===
sysinfo.txt
*.pidb.meta
*.pdb.meta
*.mdb.meta
*.apk
*.aab
*.unitypackage
*.app
crashlytics-build.properties

# === Visual Studio Code ===
# Ignora la config local, pero conserva settings/extensions compartibles
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# === Otros editores ===
.idea/
*.swp

# === Sistema operativo ===
.DS_Store
Thumbs.db
desktop.ini

# === Paquetes locales ===
# (Packages/manifest.json y packages-lock.json SÍ deben subirse)
/[Pp]ackages/com.unity.*/
